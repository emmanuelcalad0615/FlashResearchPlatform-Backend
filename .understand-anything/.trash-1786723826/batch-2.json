    {
      "id": "file:packages/core/models/instrument.py",
      "type": "file",
      "name": "instrument.py",
      "filePath": "packages/core/models/instrument.py",
      "summary": "Defines the Instrument ORM model, the catalog of tradable tickers (ticker, exchange, sector, active/delisted status) with constraints and indexes for the market-scanning universe.",
      "tags": ["data-model", "database", "orm", "table-definition", "market-data"],
      "complexity": "moderate",
      "languageNotes": "Uses SQLAlchemy 2.0-style Mapped/mapped_column typing, a CheckConstraint restricting exchange to NYSE/NASDAQ/AMEX/OTHER, and a partial index on is_active to keep delisted-but-retained rows (avoiding survivorship bias) queryable efficiently."
    },
    {
