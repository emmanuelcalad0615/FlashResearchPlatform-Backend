    {
      "id": "file:migrations/env.py",
      "type": "file",
      "name": "env.py",
      "filePath": "migrations/env.py",
      "summary": "Alembic migration environment script that loads DATABASE_URL from the environment, wires SQLAlchemy's Base.metadata as the migration target, and dispatches to offline or online migration execution.",
      "tags": ["migration", "database", "alembic", "entry-point", "configuration"],
      "complexity": "moderate",
      "languageNotes": "Standard Alembic env.py pattern: offline mode emits SQL against a URL-only config, online mode opens a real DB connection via engine_from_config before running migrations."
    },
    {
      "id": "function:migrations/env.py:run_migrations_offline",
      "type": "function",
      "name": "run_migrations_offline",
      "filePath": "migrations/env.py",
      "lineRange": [22, 31],
      "summary": "Configures Alembic to emit migration SQL using literal bind values without opening a live database connection ('offline' mode).",
      "tags": ["migration", "alembic", "database"],
      "complexity": "simple"
    },
    {
      "id": "function:migrations/env.py:run_migrations_online",
      "type": "function",
      "name": "run_migrations_online",
      "filePath": "migrations/env.py",
      "lineRange": [34, 43],
      "summary": "Creates a SQLAlchemy engine from the Alembic config, opens a live connection, and runs migrations directly against the database ('online' mode).",
      "tags": ["migration", "alembic", "database"],
      "complexity": "simple"
    },
