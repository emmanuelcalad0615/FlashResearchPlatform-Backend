      "lineRange": [7, 26],
      "summary": "Abstract port interface declaring list_instruments and get_eod_bars contracts that concrete market data provider adapters must implement.",
      "tags": ["interface", "abstract-base-class", "port"],
      "complexity": "simple"
    },
    {
      "id": "file:packages/core/providers/polygon.py",
      "type": "file",
      "name": "polygon.py",
      "filePath": "packages/core/providers/polygon.py",
      "summary": "Concrete adapter implementing MarketDataProvider for Polygon.io, handling paginated instrument listing, adjusted/unadjusted EOD bar fetching, and translation of Polygon's raw JSON into canonical InstrumentDTO/OHLCVBar schemas.",
      "tags": ["api-handler", "http-client", "adapter", "external-integration", "data-provider"],
      "complexity": "complex",
      "languageNotes": "Separates a pure translation layer (_parse_instruments, _merge_bars, module-level helpers) from the networked layer (_get, _get_aggs) to keep the fixture-based unit tests free of HTTP calls."
    },
    {
      "id": "class:packages/core/providers/polygon.py:PolygonAdapter",
      "type": "class",
      "name": "PolygonAdapter",
      "filePath": "packages/core/providers/polygon.py",
      "lineRange": [32, 138],
      "summary": "Concrete MarketDataProvider adapter for Polygon.io; manages a reused httpx.Client, paginates the reference tickers endpoint via cursor, fetches adjusted and unadjusted daily aggregates, and merges them into canonical OHLCVBar records keyed by timestamp.",
      "tags": ["adapter", "http-client", "external-integration", "api-handler"],
      "complexity": "complex"
    },
