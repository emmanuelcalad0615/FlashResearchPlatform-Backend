      "name": "base.py",
      "filePath": "packages/core/providers/base.py",
      "summary": "Defines the abstract MarketDataProvider port (hexagonal architecture) that all market data adapters must implement, decoupling the rest of the system from any specific data vendor.",
      "tags": ["interface", "abstract-base-class", "data-provider", "port-adapter"],
      "complexity": "simple",
      "languageNotes": "Uses Python's ABC + abstractmethod to define a hexagonal-architecture port; concrete vendor adapters (e.g. PolygonAdapter) implement this contract."
    },
    {
      "id": "class:packages/core/providers/base.py:MarketDataProvider",
      "type": "class",
      "name": "MarketDataProvider",
