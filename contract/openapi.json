{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "description": "El cuerpo de `error` que arma build_error_response().",
        "properties": {
          "code": {
            "description": "Codigo estable, snake_case, legible por maquina. Es EL contrato con el frontend. Valores actuales: not_found, conflict, unauthorized, forbidden, validation_error, rate_limited, internal_error, bad_gateway, service_unavailable, bad_request, method_not_allowed, not_acceptable, unsupported_media_type, http_error.",
            "examples": [
              "not_found"
            ],
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "Contexto estructurado del error. {} cuando no hay nada que anadir.",
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "Texto para humanos. Puede cambiar sin romper a nadie.",
            "examples": [
              "Resource not found"
            ],
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Id de la peticion, para cruzar con los logs. Ausente cuando la peticion no llego a tener uno.",
            "title": "Request Id"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "El unico formato de error de la API.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Respuesta del healthcheck.",
        "properties": {
          "status": {
            "description": "Estado del servicio. 'ok' cuando responde con normalidad.",
            "examples": [
              "ok"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MeResponse": {
        "description": "Identidad del usuario de la sesion actual.\n\nEs lo que el frontend pregunta al cargar cada pagina. No puede deducirlo\nsolo: la cookie de sesion es HttpOnly, asi que su JavaScript no la ve.\n\nDeclarada como response_model, recorta la salida a estos cuatro campos. El\npassword_hash del User no puede escaparse aunque alguien lo devolviera por\nerror.",
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "email_verified",
          "display_name"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "MessageResponse": {
        "description": "Respuesta generica de los endpoints que no devuelven datos.\n\nDeclarada como response_model, FastAPI RECORTA la salida a estos campos.\nSi alguien devolviera de mas —la entidad completa, por ejemplo— el\npassword_hash no llegaria al cliente.\n\nNo lleva email, ni id, ni si la cuenta era nueva: el signup responde igual\nen sus tres ramas, y devolver el email confirmaria que se proceso esa\ndireccion.",
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "MessageResponse",
        "type": "object"
      },
      "ResendVerificationRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "ResendVerificationRequest",
        "type": "object"
      },
      "RootResponse": {
        "description": "Saludo de la raiz: sirve para confirmar que la API esta arriba.",
        "properties": {
          "message": {
            "examples": [
              "Flash Research API is running"
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "RootResponse",
        "type": "object"
      },
      "SignupRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignupRequest",
        "type": "object"
      },
      "VerifyEmailRequest": {
        "properties": {
          "token": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "VerifyEmailRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Flash Research API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/": {
