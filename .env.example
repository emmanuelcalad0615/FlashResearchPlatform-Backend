# ============================================================
# Base de datos — debe coincidir con docker-compose.yml
# ============================================================
DATABASE_URL=postgresql://flash:flash_dev_pw@localhost:5432/flash_research

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# App
# true en desarrollo para ver logs detallados
# false en producción
# ============================================================
DEBUG=true
POLYGON_API_KEY=tu_key_aqui

# ============================================================
# Logging
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_JSON:  true en producción (una línea JSON por evento)
#            false en desarrollo (texto coloreado y legible)
# ============================================================
LOG_LEVEL=INFO
LOG_JSON=false

# ============================================================
# CORS
# Orígenes exactos permitidos, separados por coma.
# 5173 = puerto por defecto de Vite (frontend en desarrollo).
# NUNCA usar "*": rompe con credenciales y abre la API a cualquier sitio.
# ============================================================
CORS_ORIGINS=http://localhost:5173

# ============================================================
# Rate limiting (ventana fija por IP, contador en Redis)
# RATE_LIMIT_EXEMPT_PATHS: rutas sin límite, separadas por coma.
#   /health va exento: el healthcheck de Docker lo llama cada 5s.
# Si Redis se cae, la API sigue atendiendo SIN límite (fail open):
#   un limitador caído no debe tumbar el producto entero.
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXEMPT_PATHS=/health
