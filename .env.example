# ============================================================
# Base de datos — debe coincidir con docker-compose.yml
# ============================================================
DATABASE_URL=postgresql://flash:flash_dev_pw@localhost:5432/flash_research

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# App
# true en desarrollo para ver logs detallados
# false en producción
# ============================================================
DEBUG=true
POLYGON_API_KEY=tu_key_aqui
POLYGON_BASE_URL=https://api.polygon.io

# ============================================================
# Logging
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_JSON:  true en producción (una línea JSON por evento)
#            false en desarrollo (texto coloreado y legible)
# ============================================================
LOG_LEVEL=INFO
LOG_JSON=false

# ============================================================
# CORS
# Orígenes exactos permitidos, separados por coma.
# 5173 = puerto por defecto de Vite (frontend en desarrollo).
# NUNCA usar "*": rompe con credenciales y abre la API a cualquier sitio.
# ============================================================
CORS_ORIGINS=http://localhost:5173

# ============================================================
# Rate limiting (ventana fija por IP, contador en Redis)
# RATE_LIMIT_EXEMPT_PATHS: rutas sin límite, separadas por coma.
#   /api/health va exento: el healthcheck de Docker lo llama cada 5s.
# Si Redis se cae, la API sigue atendiendo SIN límite (fail open):
#   un limitador caído no debe tumbar el producto entero.
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXEMPT_PATHS=/api/health

# RATE_LIMIT_RULES: límites por ruta, "prefijo:peticiones:segundos".
#   Las rutas sin regla usan RATE_LIMIT_REQUESTS.
#   GANA LA PRIMERA REGLA QUE CASA, así que el orden importa: escribir
#   /api/auth antes que /api/auth/login deja al login con el límite genérico,
#   y no avisa de nada.
#   Se cuenta por IP. Una oficina detrás de un NAT comparte una sola: por eso
#   el signup es 10/hora y no 3.
#   Una regla mal escrita impide que la API arranque, a propósito.
RATE_LIMIT_RULES=/api/auth/login:5:60,/api/auth/signup:10:3600,/api/auth/resend-verification:5:3600

# ============================================================
# Correo saliente
# En desarrollo apunta a Mailpit (docker compose):
#   bandeja de entrada → http://localhost:8025
# En producción, al proveedor SMTP real (Resend, SendGrid, SES).
# ============================================================
# Horas que vive el enlace de verificación de correo.
# RESEND_VERIFICATION_COOLDOWN_SECONDS: espera mínima entre dos reenvíos del
#   correo de verificación PARA LA MISMA CUENTA. Protege el buzón del usuario,
#   no el servidor: el rate limit de arriba cuenta por IP y no impide que
#   alguien escriba la dirección de otra persona desde muchas IPs.
RESEND_VERIFICATION_COOLDOWN_SECONDS=60

EMAIL_VERIFICATION_HOURS=24

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@flashresearch.local
# Base para armar el enlace de verificación que va en el correo.
FRONTEND_BASE_URL=http://localhost:5173

# ============================================================
# Tests de integración
# Base SEPARADA de la de desarrollo, para que un test no borre tus datos.
# Crearla y migrarla una vez:
#   docker compose exec db psql -U flash -c "CREATE DATABASE flash_test;"
#   DATABASE_URL=<esta misma URL> uv run alembic upgrade head
# Si no está definida, los tests de integración se omiten en vez de fallar.
# ============================================================
TEST_DATABASE_URL=postgresql://flash:flash_dev_pw@localhost:5432/flash_test

# ============================================================
# Auth
# JWT_SECRET: la LLAVE MAESTRA. Quien la tenga puede fabricar tokens
#   válidos con cualquier identidad. Va VACÍA aquí a propósito: cada
#   entorno genera la suya y vive solo en su .env, nunca en git.
#   generar con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Valores de producción (ver deployment-decisions.md):
#   ACCESS_TOKEN_MINUTES=15   REFRESH_TOKEN_DAYS=7   COOKIE_SECURE=true
# ============================================================
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
